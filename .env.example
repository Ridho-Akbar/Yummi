# ============================================
# YUMM! ENVIRONMENT VARIABLES
# ============================================
# Cara pakai:
# 1. Copy file ini menjadi .env.local
#    cp .env.example .env.local
# 2. Isi setiap nilai sesuai panduan di bawah
# 3. Jangan commit .env.local ke Git
# ============================================

# --------------------------------------------
# SUPABASE
# --------------------------------------------
# Cara mendapatkan ketiga nilai di bawah:
# 1. Buka https://supabase.com/dashboard
# 2. Pilih project kamu
# 3. Klik ikon Settings (gerigi) di sidebar kiri
# 4. Pilih "API"
# 5. Salin dari bagian "Project URL" dan "Project API keys"
# --------------------------------------------

# URL proyek Supabase. Format: https://xxxxx.supabase.co
# Prefix NEXT_PUBLIC_ artinya nilai ini dikirim ke browser. URL memang publik.
NEXT_PUBLIC_SUPABASE_URL=

# Anon key (publishable key). Dipakai di client dan server untuk query biasa.
# Prefix NEXT_PUBLIC_ artinya nilai ini dikirim ke browser. Anon key memang publik
# karena dilindungi RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service role key. Melewati RLS. HANYA UNTUK SERVER.
# JANGAN pernah kasih prefix NEXT_PUBLIC_. JANGAN pernah ekspos ke client.
# Ambil dari bagian "service_role secret" di halaman yang sama.
SUPABASE_SERVICE_ROLE_KEY=


# --------------------------------------------
# SECURITY
# --------------------------------------------

# Salt untuk hash IP di rate limit. Panjang minimal 32 karakter random.
# Cara generate: jalankan di terminal
#   openssl rand -hex 32
# JANGAN pakai kata yang mudah ditebak. Kalau bocor, attacker bisa
# membuat rainbow table untuk membalik hash IP di database.
IP_HASH_SALT=


# --------------------------------------------
# APPLICATION URL
# --------------------------------------------

# Base URL aplikasi. Dipakai untuk link di notifikasi Telegram,
# redirect OAuth, dan canonical URL.
#
# Untuk development lokal:  http://localhost:3000
# Untuk production:         https://domain-kamu.com
#
# Kalau nilai ini salah, link notifikasi Telegram akan mengarah ke
# URL yang tidak bisa dibuka.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# --------------------------------------------
# TELEGRAM BOT (opsional)
# --------------------------------------------
# Notifikasi pesanan baru dan perubahan status ke Telegram.
# Kalau tidak diisi, sistem tetap jalan tanpa notifikasi Telegram.
#
# Cara setup:
# 1. Buka Telegram, cari @BotFather
# 2. Kirim /newbot, ikuti instruksi
# 3. Salin token yang diberikan (format: 1234567890:AAH...)
# 4. Buka chat dengan botmu, klik Start, kirim pesan apa saja
# 5. Buka di browser:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
# 6. Cari "chat":{"id":123456789} — angka itu adalah chat ID
# --------------------------------------------

# Token bot dari @BotFather. HANYA UNTUK SERVER.
TELEGRAM_BOT_TOKEN=

# Chat ID tujuan notifikasi. Bisa chat pribadi atau grup.
# Format grup: angka negatif, contoh -1001234567890.
TELEGRAM_CHAT_ID=